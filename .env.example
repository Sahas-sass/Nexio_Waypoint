# ============================================================================
# Waypoint Logistics - Environment Configuration Template
# ============================================================================

# --- Supabase Database & Auth Settings ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Server-side Supabase access (api-backend, scripts) – never expose to clients ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Backend API & Web Portals Server Settings ---
# Comma-separated origins allowed to call api-backend (web portals, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PORT=3000
NODE_ENV=production

# --- PostgreSQL Direct Connection (For Migrations & Scripts) ---
DATABASE_URL=postgresql://postgres:your_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_id
DB_PASSWORD=your_db_password
DB_NAME=postgres

# --- Mobile Driver App (mobile-driver/.env) ---
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: api-backend URL. Leave unset to auto-use the IP of the PC running Expo (port 5000).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# --- Demo accounts (scripts/seed-auth.js) ---
DEMO_PASSWORD=choose-a-strong-demo-password
